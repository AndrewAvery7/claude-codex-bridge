repository-code: "https://github.com/AndrewAvery7/claude-codex-bridge"
license: MIT
version: 1.2.1
date-released: "2026-08-30"
keywords:
  - ai coding assistants
  - agent interoperability
  - context transfer
  - claude code
  - openai codex
  - developer tooling
